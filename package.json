{
  "name": "index-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run build && npm test",
    "release": "npm run check && node scripts/release.mjs",
    "launch": "node scripts/launcher.mjs start",
    "stop": "node scripts/launcher.mjs stop",
    "setup": "node scripts/setup.mjs",
    "status": "node scripts/launcher.mjs status"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.3.4"
  },
  "description": "Private offline index editor with local SQLite storage"
}
